# ==============================================================================
# TWIN-RAG AI: Uncertainty-Aware Hybrid Graph Vector RAG Environment Settings
# ==============================================================================

# Database Configuration (SQLite default for 100% standalone zero-config operation)
DATABASE_URL=sqlite:///twin_rag.db

# LLM Provider Configuration
# Options: DEMO_FALLBACK (Default, 100% offline, zero API keys required), GEMINI, OPENAI, OLLAMA
LLM_PROVIDER=DEMO_FALLBACK

# Google Gemini API Configuration (Optional)
GEMINI_API_KEY=

# OpenAI API Configuration (Optional)
OPENAI_API_KEY=

# Local Ollama URL (Optional for local LLMs e.g. Llama-3, Mistral)
OLLAMA_BASE_URL=http://localhost:11434

# Embedding Model Selection
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Local Vector Database & Documents Storage Path
VECTOR_DB_PATH=./data/documents

# Knowledge Graph / Neo4j Integration (Optional for future scale-out)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=industrial_twin
